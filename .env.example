# ──────────────────────────────────────────────────────────
# Environment Variables — Local Development
#
# Copy this file to .env and run `docker compose up -d`
# to start all 4 Postgres databases + Kafka.
# ──────────────────────────────────────────────────────────

NODE_ENV=development

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=guri-finance-local-dev-secret

# ── IAM Postgres (port 5432) ────────────────────────────
IAM_DB_HOST=localhost
IAM_DB_PORT=5432
IAM_DB_NAME=guri_iam
IAM_DB_USER=guri_iam
IAM_DB_PASSWORD=localdev

# ── Operations Postgres (port 5433) ─────────────────────
OPS_DB_HOST=localhost
OPS_DB_PORT=5433
OPS_DB_NAME=guri_operations
OPS_DB_USER=guri_ops
OPS_DB_PASSWORD=localdev

# ── Ledger Postgres (port 5434) ─────────────────────────
LEDGER_DB_HOST=localhost
LEDGER_DB_PORT=5434
LEDGER_DB_NAME=guri_ledger
LEDGER_DB_USER=guri_ledger
LEDGER_DB_PASSWORD=localdev

# ── AI Postgres + pgvector (port 5435) ──────────────────
AI_DB_HOST=localhost
AI_DB_PORT=5435
AI_DB_NAME=guri_ai
AI_DB_USER=guri_ai
AI_DB_PASSWORD=localdev

# ── Kafka ───────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_OPERATIONS_EVENTS=operations.events
KAFKA_TOPIC_LEDGER_EVENTS=ledger.events

# ── Gemini ──────────────────────────────────────────────
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_API_KEY=

# ── Logging ─────────────────────────────────────────────
DB_LOGGING=true
